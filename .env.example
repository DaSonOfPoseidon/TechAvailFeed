# Copy to .env and fill in. .env is gitignored.
POSTGRES_PASSWORD=
IMAP_USER=feed-inbox@example.com
# Gmail app password (16 chars, spaces optional)
IMAP_PASSWORD=
# Mail whose subject contains this is ingested; match it to the scheduled report's subject.
MAIL_SUBJECT=TechAvailFeed
# Required: the report's exact sender address. Mail from anyone else, or that fails DMARC for
# that sender's domain, is filed under the failed label instead of being ingested.
MAIL_FROM=
# The server whose Authentication-Results header is trusted (Gmail's by default).
AUTHSERV_ID=mx.google.com
POLL_SECONDS=60
# Source system's local time: decides "before today" for mail deletion and "today" in the dashboard API.
MAIL_TZ=America/Chicago
# Optional: when set, the API's /api/v1/* and the ingest's JSON endpoints need an X-API-Key header.
API_KEY=
# Optional: comma-separated origins allowed to call the API from a browser,
# e.g. https://dashboard.example.com (pages that call it server-side don't need this).
CORS_ORIGINS=
# Optional: true serves exact job coordinates from /api/v1/map (default: rounded to ~110 m).
# They locate customers' homes; never enable it on anything reachable through a tunnel.
EXACT_COORDS=
